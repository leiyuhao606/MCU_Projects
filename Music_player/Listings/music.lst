line level    source

   1          /* ===========================================================================
   2             Buzzer music player engine  -  STC89C52RC, 11.0592 MHz
   3          
   4             Buzzer : P2.5 -> ULN2003D IN5, OUT5 (pin 12) -> net BEEP -> BZ1.
   5                      The ULN2003 inverts, so P2.5 HIGH sounds the buzzer.
   6          
   7             !! P2.5 is also the LCD1602 RW line.  The LCD is only ever written to
   8                while the buzzer is silent (see Music_BusFree) - that is safe because
   9                the LCD ignores RW while E is low, and the buzzer pin is free then.
  10          
  11             Timer 0 makes the square wave: 16 bit, reloaded from TONE[] inside its
  12             interrupt, toggling the buzzer pin once per half period.
  13             Timer 1 gives a 1 ms tick that times the notes and the display blink.
  14          
  15             The player is a small state machine.  Music_Run() is called from the main
  16             loop and returns after every note phase, so the keys stay responsive
  17             while the music plays.
  18             =========================================================================== */
  19          
  20          #include <REGX52.H>
  21          #include "music.h"
  22          #include "songs.h"
  23          
  24          sbit BEEP = P2^5;
  25          
  26          static unsigned char code *song;        /* the tune being played           */
  27          static unsigned char  cur_song;         /* its number                      */
  28          static unsigned int   idx;              /* position in the note table      */
  29          static unsigned int   pos;              /* units played so far             */
  30          static unsigned char  state;            /* MUS_STOP / MUS_PLAY / MUS_PAUSE */
  31          static unsigned char  phase;            /* 0 = sounding, 1 = gap           */
  32          static unsigned char  unit_ms;          /* ms per unit for this song       */
  33          static unsigned int   gap_ms;           /* length of the gap after a note  */
  34          static unsigned int   sound_ms;         /* length of the note itself       */
  35          static unsigned int   half_period;      /* Timer 0 reload                  */
  36          static unsigned int   ms_count;         /* note phase countdown            */
  37          
  38          unsigned int g_ui_ms;                   /* UI countdown, 1 ms per tick     */
  39          
  40          
  41          /* ---- Timer 0: one interrupt per half period -> square wave -------------- */
  42          void Timer0_ISR(void) interrupt 1
  43          {
  44   1          TH0 = (unsigned char)(half_period >> 8);
  45   1          TL0 = (unsigned char)half_period;
  46   1          BEEP = !BEEP;
  47   1      }
  48          
  49          /* ---- Timer 1: 1 ms tick for the note lengths and the UI ---------------- */
  50          void Timer1_ISR(void) interrupt 3
  51          {
  52   1          TH1 = 0xFC;             /* 65536 - 921 = 1 ms at 11.0592 MHz */
  53   1          TL1 = 0x67;
  54   1          if (ms_count != 0) ms_count--;
C51 COMPILER V9.60.7.0   MUSIC                                                             09/30/2026 09:28:04 PAGE 2   

  55   1          if (g_ui_ms  != 0) g_ui_ms--;
  56   1      }
  57          
  58          
  59          static void Tone_On(unsigned char note)
  60          {
  61   1          half_period = TONE[note];
  62   1          TH0 = (unsigned char)(half_period >> 8);
  63   1          TL0 = (unsigned char)half_period;
  64   1          TR0 = 1;
  65   1      }
  66          
  67          static void Tone_Off(void)
  68          {
  69   1          TR0  = 0;
  70   1          BEEP = 0;
  71   1      }
  72          
  73          
  74          /*  Pick up the event at idx and start sounding it.                        */
  75          static void Start_Event(void)
  76          {
  77   1          unsigned char note  = song[idx];
  78   1          unsigned char units = song[idx + 1];
  79   1          unsigned int  ms;
  80   1      
  81   1          pos += units;
  82   1          idx += 2;
  83   1      
  84   1          ms = (unsigned int)units * unit_ms;
  85   1      
  86   1          if (note == N_REST)
  87   1          {
  88   2              /*  a rest is silent for its WHOLE length - getting this wrong is
  89   2                  what makes a tune run fast and blur together                 */
  90   2              Tone_Off();
  91   2              phase    = 1;
  92   2              sound_ms = 0;
  93   2              gap_ms   = ms;
  94   2              ms_count = ms;
  95   2              return;
  96   2          }
  97   1      
  98   1          /*  a note sounds for most of its length and leaves a short gap at the
  99   1              end, so repeated notes stay separate.  That gap is also the only
 100   1              moment the LCD may be written to.                                */
 101   1          gap_ms = ms >> 4;
 102   1          if (gap_ms < 8)         gap_ms = 8;     /* room for a display update */
 103   1          if (gap_ms > (ms >> 1)) gap_ms = ms >> 1;
 104   1      
 105   1          Tone_On(note);
 106   1          sound_ms = ms - gap_ms;
 107   1          phase    = 0;
 108   1          ms_count = sound_ms;
 109   1      }

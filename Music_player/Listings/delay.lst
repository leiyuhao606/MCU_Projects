   1          #include <REGX52.H>
   2          #include <intrins.h>
   3          
   4          /*  1 ms blocking delay, calibrated for an 11.0592 MHz crystal.
   5              The schematic of the PuZhong-2/3/4 board shows an 11.0592 MHz crystal,
   6              and this is the same code the teach_project test project uses.        */
   7          void Delay1ms(void)
   8          {
   9   1          unsigned char data i, j;
  10   1      
  11   1          _nop_();
  12   1          i = 2;
  13   1          j = 199;
  14   1          do
  15   1          {
  16   2              while (--j);
  17   2          } while (--i);
  18   1      }
  19          
  20          void Delay_ms(unsigned char ms)
  21          {
  22   1          while (ms--)
  23   1          {
  24   2              Delay1ms();
  25   2          }
  26   1      }



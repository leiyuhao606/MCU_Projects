 137          /* ---- keys --------------------------------------------------------------- */
 138          
 139          static void Handle_Key(unsigned char k)
 140          {
 141   1          int           step;
 142   1          unsigned char was_playing;
 143   1      
 144   1          if (ui == UI_SELECT)
 145   1          {
 146   2              if (k == KEY_PREV)
 147   2              {
 148   3                  if (sel > 0)
 149   3                  {
 150   4                      sel--;
 151   4                      Music_Load(sel);
 152   4                      Draw_Head();
 153   4                      Draw_Select();
 154   4                  }
 155   3              }
 156   2              else if (k == KEY_NEXT)
 157   2              {
 158   3                  if (sel + 1 < SONG_COUNT)
 159   3                  {
 160   4                      sel++;
 161   4                      Music_Load(sel);
 162   4                      Draw_Head();
 163   4                      Draw_Select();
 164   4                  }
 165   3              }
 166   2              else if (k == KEY_MODE)                 /* play */
 167   2              {
 168   3                  Music_Load(sel);
 169   3                  ui = UI_PLAY;
 170   3                  Draw_Head();
 171   3                  Draw_Bar();                         /* buzzer still silent here */
 172   3                  Music_Start();                      /* ... then start playing   */
 173   3              }
 174   2              return;
 175   2          }
 176   1      
 177   1          /* ---- playing ---- */
 178   1          if (k == KEY_MODE)                          /* pause / resume */
C51 COMPILER V9.60.7.0   MAIN                                                              09/30/2026 09:28:04 PAGE 4   

 179   1          {
 180   2              if (Music_State() == MUS_PLAY)
 181   2              {
 182   3                  Music_Pause();
 183   3                  blink_on = 1;
 184   3                  Draw_Edge();                        /* solid edge while paused */
 185   3              }
 186   2              else if (Music_State() == MUS_PAUSE)
 187   2              {
 188   3                  Music_Resume();
 189   3              }
 190   2              return;
 191   2          }
 192   1      
 193   1          if (k == KEY_PREV || k == KEY_NEXT)         /* +- 10 seconds */
 194   1          {
 195   2              step = (int)(10000 / (unsigned int)Music_UnitMs());
 196   2      
 197   2              was_playing = (unsigned char)(Music_State() == MUS_PLAY);
 198   2              if (was_playing) Music_Pause();         /* quiet while the bar redraws */
 199   2      
 200   2              if (k == KEY_PREV) Music_Seek(-step);
 201   2              else               Music_Seek(step);
 202   2      
 203   2              Draw_Bar();
 204   2      
 205   2              if (was_playing) Music_Resume();
 206   2              return;
 207   2          }
 208   1      
 209   1          if (k == KEY_STOP)                          /* back to the selection */
 210   1          {
 211   2              Music_Halt();
 212   2              ui = UI_SELECT;
 213   2              Draw_Head();
 214   2              Draw_Select();
 215   2              return;
 216   2          }
 217   1      }

line level    source

   1          /* ===========================================================================
   2             Music player  -  STC89C52RC (8 KB) + buzzer + LCD1602
   3             Keil C51 / uVision 5
   4          
   5             Two tunes are built in; the melody of each was taken note for note out of
   6             a MIDI file and lives in songs.h.
   7          
   8             Keys (the four independent buttons, active low):
   9               selection screen   P3.1 / P3.2   previous / next tune
  10                                  P3.0          play the selected tune
  11               while playing      P3.0          pause, press again to resume
  12                                  P3.1          rewind  10 seconds
  13                                  P3.2          forward 10 seconds
  14                                  P3.3          stop and go back to the selection
  15          
  16               (P3.2 is shared with the board's infrared receiver, so the key scan
  17                filters pulse trains out - see keypad.c.)
  18          
  19             Display
  20               line 1   <number> <short name>          e.g.  1 MKDR
  21               line 2   selection screen : <number>/<total>
  22                        playing          : a progress bar whose leading edge blinks
  23                                           while the music runs, and stays solid
  24                                           while it is paused
  25          
  26             Hardware note: the buzzer sits on P2.5, which is also the LCD RW line.
  27             Everything written to the LCD therefore waits until the buzzer is silent
  28             (Music_BusFree), which keeps the two from interfering.
  29             =========================================================================== */
  30          
  31          #include <REGX52.H>
  32          #include "lcd1602.h"
  33          #include "keypad.h"
  34          #include "delay.h"
  35          #include "music.h"
  36          
  37          #define UI_SELECT   0
  38          #define UI_PLAY     1
  39          
  40          #define BAR_LEN     16
  41          #define BLINK_MS    300
  42          
  43          /*  character generator slot 0: a solid block, the progress bar cell        */
  44          unsigned char code BLOCK[8] =
  45          {
  46              0x1F, 0x1F, 0x1F, 0x1F, 0x1F, 0x1F, 0x1F, 0x1F
  47          };
  48          
  49          static unsigned char ui;            /* UI_SELECT or UI_PLAY               */
  50          static unsigned char sel;           /* tune highlighted in the selection  */
  51          static unsigned char blink_on;      /* state of the blinking edge         */
  52          static unsigned char bar_fill;      /* cells filled when last drawn       */
  53          
  54          
C51 COMPILER V9.60.7.0   MAIN                                                              09/30/2026 09:28:04 PAGE 2   

  55          /* ---- drawing ------------------------------------------------------------ */
  56          
  57          static void Draw_Head(void)         /* line 1: number + short name */
  58          {
  59   1          LCD1602_ShowString(1, 1, "                ");
  60   1          LCD1602_ShowChar(1, 1, (unsigned char)('1' + sel));
  61   1          LCD1602_ShowChar(1, 2, ' ');
  62   1          LCD1602_ShowString(1, 3, Music_Name(sel));
  63   1      }
  64          
  65          static void Draw_Select(void)       /* line 2: number / total */
  66          {
  67   1          LCD1602_ShowString(2, 1, "                ");
  68   1          LCD1602_ShowChar(2, 1, (unsigned char)('1' + sel));
  69   1          LCD1602_ShowChar(2, 2, '/');
  70   1          LCD1602_ShowChar(2, 3, (unsigned char)('0' + SONG_COUNT));
  71   1      }
  72          
  73          /* how many of the 16 cells are full right now */
  74          static unsigned char Bar_Fill(void)
  75          {
  76   1          unsigned int  total = Music_Total();
  77   1          unsigned char f;
  78   1      
  79   1          if (total == 0) return 0;
  80   1      
  81   1          f = (unsigned char)(((unsigned int)Music_Pos() * BAR_LEN) / total);
  82   1          if (f > BAR_LEN) f = BAR_LEN;
  83   1          return f;
  84   1      }
  85          
  86          static void Draw_Bar(void)          /* the whole progress bar */
  87          {
  88   1          unsigned char i;
  89   1      
  90   1          bar_fill = Bar_Fill();
  91   1          for (i = 0; i < BAR_LEN; i++)
  92   1          {
  93   2              LCD1602_ShowChar(2, i + 1, (unsigned char)((i < bar_fill) ? 0 : ' '));
  94   2          }
  95   1          blink_on = 1;
  96   1      }
  97          
  98          static void Draw_Edge(void)         /* only the leading edge cell */
  99          {
 100   1          unsigned char col = (unsigned char)(bar_fill + 1);
 101   1      
 102   1          if (col > BAR_LEN) col = BAR_LEN;
 103   1          LCD1602_ShowChar(2, col, (unsigned char)(blink_on ? 0 : ' '));
 104   1      }
 105          
 106          
 107          /* ---- the blink, driven by the 1 ms tick --------------------------------- */
 108          
 109          /*  Called from the main loop while the music plays.
 110              Writing to the LCD pulls P2.5 low (the LCD RW line) for about 2 ms per
 111              character, so every update is kept to ONE character and only done while
 112              the buzzer is in the silent part of a note.  Redrawing the whole bar
 113              takes 64 ms, which is why the full bar is only ever drawn while the
 114              player is stopped (see Handle_Key).                                   */
 115          static void Ui_Tick(void)
 116          {
C51 COMPILER V9.60.7.0   MAIN                                                              09/30/2026 09:28:04 PAGE 3   

 117   1          unsigned char f = Bar_Fill();
 118   1      
 119   1          if (f > bar_fill)                       /* the bar has grown by a cell */
 120   1          {
 121   2              if (!Music_BusFree()) return;
 122   2              LCD1602_ShowChar(2, bar_fill + 1, 0);
 123   2              bar_fill++;
 124   2              blink_on = 1;
 125   2              return;
 126   2          }
 127   1      
 128   1          if (g_ui_ms == 0 && Music_BusFree())    /* blink the leading edge */
 129   1          {
 130   2              g_ui_ms  = BLINK_MS;
 131   2              blink_on = (unsigned char)(!blink_on);
 132   2              Draw_Edge();
 133   2          }
 134   1      }

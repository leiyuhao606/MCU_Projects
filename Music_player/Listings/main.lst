 221          
 222          void main(void)
 223          {
 224   1          unsigned char k;
 225   1      
 226   1          Delay_ms(100);                              /* LCD power on reset */
 227   1          LCD1602_Init();
 228   1          LCD1602_LoadChar(0, BLOCK);
 229   1      
 230   1          Key_Init();
 231   1          Music_Init();
 232   1      
 233   1          ui       = UI_SELECT;
 234   1          sel      = 0;
 235   1          blink_on = 1;
 236   1          bar_fill = 0;
 237   1      
 238   1          Music_Load(sel);
 239   1          Draw_Head();
 240   1          Draw_Select();
C51 COMPILER V9.60.7.0   MAIN                                                              09/30/2026 09:28:04 PAGE 5   

 241   1      
 242   1          while (1)
 243   1          {
 244   2              k = Key_Scan();

   1          #include <REGX52.H>
   2          #include "lcd1602.h"
   3          #include "delay.h"
   4          
   5          /*  LCD1602 wiring on the PuZhong-2/3/4 board.
   6              Taken from the teach_project test project and confirmed against the
   7              schematic PDF ("LCD1602" connector):
   8          
   9                  LCD pin 4  RS  -> P2.6   (net LCD_RS)
  10                  LCD pin 5  RW  -> P2.5   (net LCD_WR)
  11                  LCD pin 6  E   -> P2.7   (net LCD_EN)
  12                  LCD pin 7-14 D0-D7 -> P0 (nets LCD_D0 .. LCD_D7)
  13          
  14              Note: P0 is also wired to the 7-segment display of the board.  This
  15              project therefore never drives the 7-segment digit select lines
  16              (P2.2-P2.4), so the two displays do not disturb each other.          */
  17          sbit LCD1602_RS = P2^6;
  18          sbit LCD1602_RW = P2^5;
  19          sbit LCD1602_E  = P2^7;
  20          
  21          #define LCD1602_DATAPORT P0
  22          
  23          
  24          void LCD1602_WriteCommand(unsigned char Command)
  25          {
  26   1          LCD1602_RS = 0;
  27   1          LCD1602_RW = 0;
  28   1          LCD1602_DATAPORT = Command;
  29   1          LCD1602_E = 1;
  30   1          Delay1ms();
  31   1          LCD1602_E = 0;
  32   1          Delay1ms();
  33   1      }
  34          
  35          void LCD1602_WriteData(unsigned char Data)
  36          {
  37   1          LCD1602_RS = 1;
  38   1          LCD1602_RW = 0;
  39   1          LCD1602_DATAPORT = Data;
  40   1          LCD1602_E = 1;
  41   1          Delay1ms();
  42   1          LCD1602_E = 0;
  43   1          Delay1ms();
  44   1      }
  45          
  46          void LCD1602_Init(void)
  47          {
  48   1          LCD1602_WriteCommand(0x38);     /* 8 bit bus, 2 lines, 5x7 dots */
  49   1          LCD1602_WriteCommand(0x0C);     /* display on, cursor off       */
  50   1          LCD1602_WriteCommand(0x06);     /* auto increment, no shift     */
  51   1          LCD1602_WriteCommand(0x01);     /* clear display                */
  52   1      }
  53          
  54          void LCD1602_SetCursor(unsigned char Line, unsigned char Column)
C51 COMPILER V9.60.7.0   LCD1602                                                           09/27/2026 12:33:09 PAGE 2   

  55          {
  56   1          if (Line == 1)
  57   1          {
  58   2              LCD1602_WriteCommand(0x80 | (Column - 1));
  59   2          }
  60   1          else
  61   1          {
  62   2              LCD1602_WriteCommand(0x80 | (Column - 1) + 0x40);
  63   2          }
  64   1      }
  65          
  66          void LCD1602_ShowChar(unsigned char Line, unsigned char Column, unsigned char Char)
  67          {
  68   1          LCD1602_SetCursor(Line, Column);
  69   1          LCD1602_WriteData(Char);
  70   1      }
  71          
  72          void LCD1602_ShowString(unsigned char Line, unsigned char Column, unsigned char code *String)
  73          {
  74   1          unsigned char i;
  75   1      
  76   1          LCD1602_SetCursor(Line, Column);
  77   1          for (i = 0; String[i] != '\0'; i++)
  78   1          {
  79   2              LCD1602_WriteData(String[i]);
  80   2          }
  81   1      }
  82          
  83          /* show one decimal digit, 0..9 */
  84          void LCD1602_ShowDigit(unsigned char Line, unsigned char Column, unsigned char Number)
  85          {
  86   1          LCD1602_ShowChar(Line, Column, (unsigned char)('0' + Number));
  87   1      }



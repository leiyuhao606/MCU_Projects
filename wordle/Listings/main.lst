 117          /* the whole of line 2 for the current state, rebuilt from the game data */
 118          static void Draw_Line2(void)
 119          {
 120   1          unsigned char i;
 121   1      
 122   1          if (state == ST_WIN)
 123   1          {
 124   2              LCD1602_ShowString(2, 1, "Congratulation  ");
 125   2              return;
 126   2          }
 127   1          if (state == ST_INVALID)
 128   1          {
 129   2              LCD1602_ShowString(2, 1, "Invalid word    ");
 130   2              return;
 131   2          }
 132   1          if (state == ST_LOSE)
 133   1          {
 134   2              /*  the game is over, so show the word the player was looking for:
 135   2                  "You lose! " fills columns 1..10 and the answer follows it      */
 136   2              LCD1602_ShowString(2, 1, "You lose! ");
 137   2              for (i = 0; i < WORD_LEN; i++)
 138   2              {
 139   3                  LCD1602_ShowChar(2, 11 + i, answer[i]);
 140   3              }
 141   2              LCD1602_ShowChar(2, 16, ' ');
 142   2              return;
 143   2          }
 144   1      
 145   1          /* the five input boxes */
 146   1          for (i = 0; i < WORD_LEN; i++)
 147   1          {
 148   2              if (state == ST_RESULT || i < input_len)
 149   2              {
 150   3                  LCD1602_ShowChar(2, COL_INPUT + i, cur_word[i]);
 151   3              }
 152   2              else
 153   2              {
 154   3                  LCD1602_ShowChar(2, COL_INPUT + i, BOX_EMPTY);
 155   3              }
 156   2          }
 157   1          LCD1602_ShowChar(2, COL_INPUT + WORD_LEN, ' ');     /* column 6 */
 158   1      
 159   1          if (state == ST_RESULT)
 160   1          {
 161   2              /* the staging box and the four cells after it show the result */
 162   2              for (i = 0; i < WORD_LEN; i++)
 163   2              {
 164   3                  LCD1602_ShowChar(2, COL_MARK + i, guess_mark[rounds - 1][i]);
 165   3              }
 166   2              /* blank the rest of the line: the history screen writes further
 167   2                 right, so those cells must not be left behind */
 168   2              for (i = COL_MARK + WORD_LEN; i <= 16; i++)
 169   2              {
 170   3                  LCD1602_ShowChar(2, i, ' ');
 171   3              }
 172   2          }
 173   1          else
 174   1          {
 175   2              LCD1602_ShowChar(2, COL_STAGE, stage_ch ? stage_ch : BOX_EMPTY);
 176   2              for (i = COL_STAGE + 1; i <= 16; i++)
 177   2              {
 178   3                  LCD1602_ShowChar(2, i, ' ');
C51 COMPILER V9.60.7.0   MAIN                                                              09/27/2026 12:33:09 PAGE 4   

 179   3              }
 180   2          }
 181   1      }

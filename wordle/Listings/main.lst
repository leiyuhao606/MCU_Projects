 441          /* ======================= main ============================================ */
 442          
 443          void main(void)
 444          {
 445   1          unsigned char k;
 446   1      
 447   1          Key_Init();
 448   1      
 449   1          /* free running timer 0, used only as a source of randomness */
 450   1          TMOD = (TMOD & 0xF0) | 0x01;
 451   1          TH0  = 0;
 452   1          TL0  = 0;
 453   1          TR0  = 1;
 454   1      
 455   1          input_len    = 0;
 456   1          stage_ch     = 0;
 457   1          page         = 0;
 458   1          view         = VIEW_PLAY;
 459   1          hist_idx     = 0;
 460   1          rounds       = 0;
 461   1          state        = ST_INPUT;
 462   1          won          = 0;
 463   1          answer_ready = 0;
 464   1      
 465   1          Delay_ms(100);                  /* let the LCD finish its power on reset */
 466   1          LCD1602_Init();
 467   1      
 468   1          Draw_PlayTop();
 469   1          Draw_Line2();
 470   1      
 471   1          while (1)
 472   1          {
 473   2              k = Key_Scan();
 474   2              if (k == KEY_NONE) continue;
 475   2      
 476   2              if (answer_ready == 0)
 477   2              {
 478   3                  Pick_Answer();          /* seeded by the first key press */
 479   3              }
 480   2      
 481   2              if (k == KEY_MODE)
 482   2              {
 483   3                  Key_Mode();
 484   3                  continue;
 485   3              }
 486   2      
 487   2              if (view == VIEW_HIST)
 488   2              {
C51 COMPILER V9.60.7.0   MAIN                                                              09/27/2026 12:33:09 PAGE 9   

 489   3                  Key_History(k);
 490   3                  continue;
 491   3              }
 492   2      
 493   2              Key_Play(k);
 494   2          }
 495   1      }



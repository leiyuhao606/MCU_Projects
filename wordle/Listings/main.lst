  65          static unsigned char idata guess_word[MAX_ROUND][WORD_LEN];
  66          static unsigned char idata guess_mark[MAX_ROUND][WORD_LEN];
  67          static unsigned char idata cur_word[WORD_LEN];      /* word being typed   */
  68          static unsigned char idata answer[WORD_LEN];        /* the secret word    */
  69          
  70          static unsigned char input_len;         /* 0..5 letters in the input boxes  */
  71          static unsigned char stage_ch;          /* 0 = staging box empty            */
  72          static unsigned char page;              /* 0 = A-M, 1 = N-Z                 */
  73          static unsigned char view;              /* VIEW_PLAY / VIEW_HIST            */
  74          static unsigned char hist_idx;          /* history entry being shown        */
  75          static unsigned char rounds;            /* number of graded guesses, 0..6   */
  76          static unsigned char state;             /* ST_xxx                           */
  77          static unsigned char won;               /* last graded guess was correct    */

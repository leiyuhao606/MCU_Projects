 212          
 213          /* ======================= game logic ====================================== */
 214          
 215          /*  Draw a random answer from the word pool.
 216              Called on the first key press of the game: timer 0 has been running free
 217              since power up, so its value depends on how long the player took to touch
 218              the keypad - the only real entropy an 8051 has.                        */
 219          static void Pick_Answer(void)
 220          {
 221   1          unsigned int t;
 222   1      
 223   1          t  = ((unsigned int)TH0 << 8) | (unsigned int)TL0;
 224   1          t ^= (unsigned int)(t << 7);        /* spread the timer value out */
 225   1          t ^= (unsigned int)(t >> 9);
 226   1          t ^= (unsigned int)(t << 8);
 227   1      
 228   1          Dict_RandomAnswer(answer, t);
 229   1          answer_ready = 1;
 230   1      }
 231          
 232          /*  Standard Wordle grading.
 233              Pass 1 marks every letter that is in the right place green ('G').
 234              Pass 2 walks the remaining positions from left to right and marks a
 235              letter yellow ('Y') only while the answer still holds an unused copy of
 236              it - that is what makes repeated letters behave correctly.
 237              Everything else is red ('R').                                         */
 238          static void Evaluate(unsigned char idata *word, unsigned char idata *mark)
 239          {
 240   1          unsigned char i, j, total, seen;
C51 COMPILER V9.60.7.0   MAIN                                                              09/27/2026 12:33:09 PAGE 5   

 241   1      
 242   1          for (i = 0; i < WORD_LEN; i++)
 243   1          {
 244   2              mark[i] = (word[i] == answer[i]) ? 'G' : 'R';
 245   2          }
 246   1      
 247   1          for (i = 0; i < WORD_LEN; i++)
 248   1          {
 249   2              if (mark[i] == 'G') continue;
 250   2      
 251   2              /* copies of this letter still available in the answer */
 252   2              total = 0;
 253   2              for (j = 0; j < WORD_LEN; j++)
 254   2              {
 255   3                  if (mark[j] != 'G' && answer[j] == word[i]) total++;
 256   3              }
 257   2              /* copies already spent on yellows in front of position i */
 258   2              seen = 0;
 259   2              for (j = 0; j < i; j++)
 260   2              {
 261   3                  if (mark[j] == 'Y' && word[j] == word[i]) seen++;
 262   3              }
 263   2      
 264   2              if (seen < total) mark[i] = 'Y';
 265   2          }
 266   1      }
 267          
 268          /* the player pressed key 16 with a full word in the boxes */
 269          static void Submit_Guess(void)
 270          {
 271   1          unsigned char i;
 272   1      
 273   1          /* a guess only counts when it is a word the dictionary knows */
 274   1          if (Dict_Has(cur_word) == 0)
 275   1          {
 276   2              state = ST_INVALID;
 277   2              Draw_Line2();
 278   2              return;
 279   2          }
 280   1      
 281   1          for (i = 0; i < WORD_LEN; i++)
 282   1          {
 283   2              guess_word[rounds][i] = cur_word[i];
 284   2          }
 285   1          Evaluate(guess_word[rounds], guess_mark[rounds]);
 286   1      
 287   1          won = 1;
 288   1          for (i = 0; i < WORD_LEN; i++)
 289   1          {
 290   2              if (guess_mark[rounds][i] != 'G')
 291   2              {
 292   3                  won = 0;
 293   3                  break;
 294   3              }
 295   2          }
 296   1      
 297   1          rounds++;
 298   1          state = ST_RESULT;
 299   1          Draw_Round();
 300   1          Draw_Line2();
 301   1      }
 302          
C51 COMPILER V9.60.7.0   MAIN                                                              09/27/2026 12:33:09 PAGE 6   

 303          /* the player pressed key 16 while a graded word was on screen */
 304          static void Next_Round(void)
 305          {
 306   1          if (won)
 307   1          {
 308   2              state = ST_WIN;
 309   2              Draw_Line2();
 310   2              return;
 311   2          }
 312   1          if (rounds >= MAX_ROUND)
 313   1          {
 314   2              state = ST_LOSE;
 315   2              Draw_Line2();
 316   2              return;
 317   2          }
 318   1      
 319   1          input_len = 0;
 320   1          stage_ch  = 0;
 321   1          state     = ST_INPUT;
 322   1          Draw_Round();
 323   1          Draw_Line2();
 324   1      }

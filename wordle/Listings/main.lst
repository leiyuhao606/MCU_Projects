 109          /* line 1 of the play screen */
 110          static void Draw_PlayTop(void)
 111          {
 112   1          LCD1602_ShowString(1, 1, "Wordle  ");   /* also wipes "History" */
 113   1          Draw_Page();
 114   1          Draw_Round();
 115   1      }

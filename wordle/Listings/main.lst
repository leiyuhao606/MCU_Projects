 326          
 327          /* ======================= key handling ==================================== */
 328          
 329          static void Key_Play(unsigned char k)
 330          {
 331   1          /* keys 1..13 are the letter keys of the current page */
 332   1          if (k >= 1 && k <= 13)
 333   1          {
 334   2              /* a full input box cannot take a new letter, not even into the
 335   2                 staging box, but backspace and enter still work */
 336   2              if (state == ST_INPUT && input_len < WORD_LEN)
 337   2              {
 338   3                  stage_ch = (unsigned char)('A' + page * 13 + (k - 1));
 339   3                  LCD1602_ShowChar(2, COL_STAGE, stage_ch);
 340   3              }
 341   2              return;
 342   2          }
 343   1      
 344   1          if (k == KEY_PAGE)
 345   1          {
 346   2              page = (unsigned char)(!page);
 347   2              Draw_Page();
 348   2              return;
 349   2          }
 350   1      
 351   1          if (k == KEY_BACK)
 352   1          {
 353   2              if (state != ST_INPUT) return;
 354   2      
 355   2              if (stage_ch != 0)
 356   2              {
 357   3                  stage_ch = 0;                               /* drop staging letter   */
 358   3                  LCD1602_ShowChar(2, COL_STAGE, BOX_EMPTY);
 359   3              }
 360   2              else if (input_len > 0)
 361   2              {
 362   3                  input_len--;                                /* else rub out last box */
 363   3                  LCD1602_ShowChar(2, COL_INPUT + input_len, BOX_EMPTY);
 364   3              }
C51 COMPILER V9.60.7.0   MAIN                                                              09/27/2026 12:33:09 PAGE 7   

 365   2              return;
 366   2          }
 367   1      
 368   1          if (k == KEY_OK)
 369   1          {
 370   2              if (state == ST_RESULT)
 371   2              {
 372   3                  Next_Round();
 373   3                  return;
 374   3              }
 375   2              if (state == ST_INVALID)
 376   2              {
 377   3                  /* the word was rejected: clear the boxes and let the player type
 378   3                     this attempt again - it does not use up one of the six tries */
 379   3                  input_len = 0;
 380   3                  stage_ch  = 0;
 381   3                  state     = ST_INPUT;
 382   3                  Draw_Line2();
 383   3                  return;
 384   3              }
 385   2              if (state != ST_INPUT) return;
 386   2      
 387   2              if (stage_ch != 0)
 388   2              {
 389   3                  cur_word[input_len] = stage_ch;             /* staging -> input box */
 390   3                  LCD1602_ShowChar(2, COL_INPUT + input_len, stage_ch);
 391   3                  input_len++;
 392   3                  stage_ch = 0;
 393   3                  LCD1602_ShowChar(2, COL_STAGE, BOX_EMPTY);
 394   3              }
 395   2              else if (input_len == WORD_LEN)
 396   2              {
 397   3                  Submit_Guess();                             /* full word: grade it  */
 398   3              }
 399   2              return;
 400   2          }
 401   1      }
 402          
 403          static void Key_History(unsigned char k)
 404          {
 405   1          if (k == KEY_PREV)
 406   1          {
 407   2              if (hist_idx > 0)
 408   2              {
 409   3                  hist_idx--;
 410   3                  Draw_History();
 411   3              }
 412   2          }
 413   1          else if (k == KEY_NEXT)
 414   1          {
 415   2              if (hist_idx + 1 < rounds)
 416   2              {
 417   3                  hist_idx++;
 418   3                  Draw_History();
 419   3              }
 420   2          }
 421   1      }
 422          
 423          /* P3.0 switches between the play screen and the history screen */
 424          static void Key_Mode(void)
 425          {
 426   1          if (view == VIEW_PLAY)
C51 COMPILER V9.60.7.0   MAIN                                                              09/27/2026 12:33:09 PAGE 8   

 427   1          {
 428   2              view     = VIEW_HIST;
 429   2              hist_idx = 0;                   /* always start at the first entry */
 430   2              Draw_History();
 431   2          }
 432   1          else
 433   1          {
 434   2              view = VIEW_PLAY;
 435   2              Draw_PlayTop();
 436   2              Draw_Line2();
 437   2          }
 438   1      }

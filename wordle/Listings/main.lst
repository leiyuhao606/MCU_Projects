  51          #define VIEW_HIST    1
  52          
  53          /* state of the current game */
  54          #define ST_INPUT     0          /* typing a word                        */
C51 COMPILER V9.60.7.0   MAIN                                                              09/27/2026 12:33:09 PAGE 2   

  55          #define ST_RESULT    1          /* last word graded, waiting for key 16 */
  56          #define ST_WIN       2

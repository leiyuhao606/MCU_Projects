 204   1          LCD1602_ShowChar(2, 8, ' ');
 205   1          for (i = 0; i < WORD_LEN; i++)
 206   1          {
 207   2              LCD1602_ShowChar(2, COL_HIST_M + i, guess_mark[hist_idx][i]);
 208   2          }

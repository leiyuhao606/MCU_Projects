  81          /* ======================= drawing ========================================= */
  82          
  83          static void Draw_Page(void)
  84          {
  85   1      #if SHOW_PAGE_HINT
  86   1          LCD1602_ShowChar (1, COL_HINT,     page ? 'N' : 'A');
  87   1          LCD1602_ShowChar (1, COL_HINT + 1, '-');
  88   1          LCD1602_ShowChar (1, COL_HINT + 2, page ? 'Z' : 'M');
  89   1      #endif
  90   1      }
  91          
  92          /* the attempt counter.  While a graded word is on screen it shows the number
  93             of that word, otherwise it shows the attempt the player is about to make.
  94             A rejected word does not use up a try, so ST_INVALID counts as "about to". */
  95          static void Draw_Round(void)
  96          {
  97   1          unsigned char r;
  98   1      
  99   1          r = (state == ST_RESULT || state == ST_WIN || state == ST_LOSE)
 100   1              ? rounds : (unsigned char)(rounds + 1);
 101   1          if (r < 1)         r = 1;
 102   1          if (r > MAX_ROUND) r = MAX_ROUND;
 103   1      
 104   1          LCD1602_ShowDigit(1, COL_ROUND,     r);
 105   1          LCD1602_ShowChar (1, COL_ROUND + 1, '/');
 106   1          LCD1602_ShowDigit(1, COL_ROUND + 2, MAX_ROUND);
 107   1      }

line level    source

   1          /* ===========================================================================
   2             Wordle  -  STC89C52RC + LCD1602 + 4x4 matrix keypad + 3 independent keys
   3             Keil C51 (uVision 5)
   4          
   5             Hardware (PuZhong-2/3/4 board, verified against the schematic PDF):
   6               LCD1602 : data P0.0-P0.7, RS = P2.6, RW = P2.5, E = P2.7
   7               Keypad  : 4x4 matrix on P1.0-P1.7  (header J20)
   8               Keys    : P3.0 = play/history, P3.1 = previous entry, P3.2 = next entry
   9               Crystal : 11.0592 MHz
  10          
  11             Matrix key map (same numbering as the teach_project test project):
  12               1..13 = letters, 14 = flip letter page, 15 = backspace, 16 = enter
  13               page A-M : key n -> 'A' + (n-1)
  14               page N-Z : key n -> 'N' + (n-1)
  15          
  16             Screen layout
  17               line 1  "Wordle" (1-6) | page hint (8-10) | "n/6" (14-16)
  18               line 2  play, input  : [ ][ ][ ][ ][ ]  [ ]     boxes 1-5, staging box 7
  19               line 2  play, graded : [word 1-5]   [G/Y/R at 7-11]
  20               line 2  history      : n (1) | word (3-7) | marks (9-13)
  21               line 2  game over    : "Congratulation" from column 1 on a win,
  22                                      "You lose! <answer>" from column 1 on a loss
  23               line 2  bad word     : "Invalid word" from column 1
  24             =========================================================================== */
  25          
  26          #include <REGX52.H>
  27          #include "lcd1602.h"
  28          #include "keypad.h"
  29          #include "delay.h"
  30          #include "dict.h"

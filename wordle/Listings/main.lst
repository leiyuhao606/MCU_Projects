 183          /* the whole of line 2 in history view */
 184          static void Draw_History(void)
 185          {
 186   1          unsigned char i;
 187   1      
 188   1          LCD1602_ShowString(1, 1, "History");
 189   1          LCD1602_ShowString(1, COL_HINT, "      ");      /* wipe the page hint */
 190   1      
 191   1          if (rounds == 0)
 192   1          {

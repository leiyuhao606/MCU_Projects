 161          /*  Non blocking scan: returns KEY_NONE when there is no *new* press.
 162              A matrix key is accepted after it reads the same twice, 10 ms apart.
 163              An independent key needs more than that: its pin must stay low without
 164              any transition for 20 ms, and must be steadily high again before it can
 165              fire once more.  That is what keeps the infrared receiver on P3.2 from
 166              being mistaken for key presses.                                       */
 167          unsigned char Key_Scan(void)
 168          {
 169   1          unsigned char k = Key_Raw();
 170   1      
 171   1          if (k == 0)
 172   1          {
 173   2              if (key_latch >= KEY_MODE)
 174   2              {
 175   3                  /*  independent key: re-arm only when its pin is genuinely idle.
 176   3                      While the IR receiver keeps pulsing on P3.2 this never comes
 177   3                      true, so one burst cannot produce a stream of events.       */
 178   3                  if (Key_Is_Free(key_latch)) key_latch = 0;
C51 COMPILER V9.60.7.0   KEYPAD                                                            09/27/2026 12:33:09 PAGE 4   

 179   3              }
 180   2              else
 181   2              {
 182   3                  key_latch = 0;              /* matrix key released - re-arm */
 183   3              }
 184   2              return KEY_NONE;
 185   2          }
 186   1      
 187   1          if (k == key_latch)
 188   1          {
 189   2              return KEY_NONE;            /* still the same press */
 190   2          }
 191   1      
 192   1          Delay_ms(10);                   /* let the contact bounce settle */
 193   1      
 194   1          if (Key_Raw() != k)
 195   1          {
 196   2              return KEY_NONE;            /* bounced away, ignore it */
 197   2          }
 198   1      
 199   1          if (k >= KEY_MODE)
 200   1          {
 201   2              if (Key_Is_Pressed(k) == 0)
 202   2              {
 203   3                  return KEY_NONE;        /* a pulse train, not a button */
 204   3              }
 205   2          }
 206   1      
 207   1          key_latch = k;
 208   1          return k;
 209   1      }



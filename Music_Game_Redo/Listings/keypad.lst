   1          #include <REGX52.H>
   2          #include "keypad.h"
   3          #include "delay.h"
   4          
   5          /* K1..K4 are physically left-to-right on the board, but their port bits are
   6           * P3.1, P3.0, P3.2, P3.3.  Keep the two notions separate in the comments and
   7           * in the game row map. */
   8          sbit IND_MODE  = P3^0;  /* K2 */
   9          sbit IND_PREV  = P3^1;  /* K1, shared with TXD */
  10          sbit IND_NEXT  = P3^2;  /* K3, shared with IR1 */
  11          sbit IND_STOP  = P3^3;  /* K4 */
  12          
  13          static unsigned char key_latch = 0;
  14          
  15          void Key_Init(void)
  16          {
  17   1          IND_MODE = 1;
  18   1          IND_PREV = 1;
  19   1          IND_NEXT = 1;
  20   1          IND_STOP = 1;
  21   1          key_latch = 0;
  22   1      }
  23          
  24          /* The chart input path samples this mask once per millisecond and applies its
  25           * own multi-key stability filter.  That lets two physically independent keys
  26           * be recognised together, which Key_Scan intentionally cannot do. */
  27          unsigned char Key_ReadMask(void)
  28          {
  29   1          unsigned char mask = 0;
  30   1      
  31   1          if (IND_MODE == 0) mask |= KEY_MASK_MODE;
  32   1          if (IND_PREV == 0) mask |= KEY_MASK_PREV;
  33   1          if (IND_NEXT == 0) mask |= KEY_MASK_NEXT;
  34   1          if (IND_STOP == 0) mask |= KEY_MASK_STOP;
  35   1          return mask;
  36   1      }
  37          
  38          /* Watch one pin for ms milliseconds and report whether it stayed at the
  39           * wanted level without a transition.  P3.2 is also the IR receiver output;
  40           * this rejects its short pulse trains on the selection screen. */
  41          static unsigned char Pin_Steady(bit pin, bit level, unsigned char ms)
  42          {
  43   1          unsigned char i, changes = 0;
  44   1          bit last = pin;
  45   1      
  46   1          for (i = 0; i < ms; i++)
  47   1          {
  48   2              Delay1ms();
  49   2              if (pin != last)
  50   2              {
  51   3                  changes++;
  52   3                  last = pin;
  53   3              }
  54   2          }
  55   1          return (unsigned char)((changes == 0) && (pin == level));
C51 COMPILER V9.60.7.0   KEYPAD                                                            09/30/2026 13:15:47 PAGE 2   

  56   1      }
  57          
  58          static unsigned char Key_Is_Pressed(unsigned char k)
  59          {
  60   1          if (k == KEY_MODE) return Pin_Steady(IND_MODE, 0, 30);
  61   1          if (k == KEY_PREV) return Pin_Steady(IND_PREV, 0, 30);
  62   1          if (k == KEY_STOP) return Pin_Steady(IND_STOP, 0, 30);
  63   1          return Pin_Steady(IND_NEXT, 0, 30);
  64   1      }
  65          
  66          static unsigned char Key_Is_Free(unsigned char k)
  67          {
  68   1          if (k == KEY_MODE) return Pin_Steady(IND_MODE, 1, 20);
  69   1          if (k == KEY_PREV) return Pin_Steady(IND_PREV, 1, 20);
  70   1          if (k == KEY_STOP) return Pin_Steady(IND_STOP, 1, 20);
  71   1          return Pin_Steady(IND_NEXT, 1, 20);
  72   1      }
  73          
  74          static unsigned char Key_Raw(void)
  75          {
  76   1          if (IND_MODE == 0) return KEY_MODE;
  77   1          if (IND_PREV == 0) return KEY_PREV;
  78   1          if (IND_NEXT == 0) return KEY_NEXT;
  79   1          if (IND_STOP == 0) return KEY_STOP;
  80   1          return KEY_NONE;
  81   1      }
  82          
  83          unsigned char Key_Scan(void)
  84          {
  85   1          unsigned char k = Key_Raw();
  86   1      
  87   1          if (k == KEY_NONE)
  88   1          {
  89   2              if (key_latch != 0)
  90   2              {
  91   3                  if (Key_Is_Free(key_latch)) key_latch = 0;
  92   3              }
  93   2              return KEY_NONE;
  94   2          }
  95   1      
  96   1          if (k == key_latch) return KEY_NONE;
  97   1      
  98   1          Delay_ms(10);
  99   1          if (Key_Raw() != k) return KEY_NONE;
 100   1          if (Key_Is_Pressed(k) == 0) return KEY_NONE;
 101   1      
 102   1          key_latch = k;
 103   1          return k;
 104   1      }



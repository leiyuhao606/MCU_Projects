 255          void Music_Start(void)
 256          {
 257   1          unsigned char saved_ea;
 258   1      
 259   1          if (state == MUS_PLAY) return;
 260   1      
 261   1          saved_ea = EA;
 262   1          EA = 0;
 263   1      

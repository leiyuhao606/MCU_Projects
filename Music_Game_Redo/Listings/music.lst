 210          static unsigned char Deadline_Reached(unsigned int now,
 211                                                unsigned int deadline)
 212          {
 213   1          /* All individual note phases are well below 32768 ms, so the signed
 214   1           * modulo comparison remains valid across the 16-bit clock wrap. */
 215   1          return (unsigned char)(((signed int)(now - deadline)) >= 0);
 216   1      }

 218          /* P2.5 is shared by the buzzer and LCD RW.  A complete pixel frame needs
 219           * several LCD transactions, so the game briefly mutes Timer 0 around that
 220           * transfer instead of waiting for the relatively infrequent note gaps. */
 221          void Music_DisplayBegin(void)
 222          {
 223   1          unsigned char saved_ea = EA;
 224   1      
 225   1          EA = 0;
 226   1          display_muted = 1;
 227   1          if (state == MUS_PLAY && phase == 0)
 228   1          {
 229   2              TR0  = 0;
 230   2              BEEP = 0;
 231   2          }
 232   1          EA = saved_ea;
 233   1      }

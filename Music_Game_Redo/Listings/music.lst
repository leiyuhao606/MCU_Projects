 267   1          phase          = 0;
 268   1          music_time_ms  = 0;
 269   1          music_deadline_ms = 0;
 270   1          music_clock_tick = 0;
 271   1          clock_div = 0;
 272   1          state = MUS_PLAY;
 273   1      
 274   1          if (song == 0 || song[idx] == N_END)
 275   1          {
 276   2              state = MUS_STOP;
 277   2              EA = saved_ea;
 278   2              return;

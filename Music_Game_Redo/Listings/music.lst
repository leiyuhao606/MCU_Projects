   1          /* Buzzer music engine for the STC89C52RC (11.0592 MHz).
   2           *
   3           * Timer 0 makes the square wave on P2.5.  Timer 1 supplies a 1 ms clock and
   4           * the game clock; the foreground calls Music_Run() against absolute note
   5           * deadlines.  P2.5 is also LCD1602 RW, so the renderer mutes Timer 0 briefly
   6           * while it transfers a frame. */
   7          
   8          #include <REGX52.H>
   9          #include "music.h"
  10          #include "songs.h"
  11          
  12          sbit BEEP = P2^5;
  13          
  14          static unsigned char code *song;
  15          static unsigned int  idx;
  16          static unsigned char state;
  17          static unsigned char phase;       /* 0 = sounding, 1 = silent gap */
  18          static unsigned char unit_ms;
  19          static unsigned int  gap_ms;
  20          static unsigned int  half_period;
  21          /* Timer 1 owns the millisecond clock.  The foreground music scheduler uses
  22           * this clock and an absolute deadline, so a long LCD transaction does not
  23           * stretch the tune and the interrupt never calls into the C51 state machine. */
  24          static unsigned int  music_time_ms;
  25          static unsigned int  music_deadline_ms;
  26          static unsigned int  music_clock_tick;
  27          static unsigned char clock_div;
  28          static unsigned char display_muted;
  29          
  30          unsigned int g_ui_ms;
  31          
  32          void Timer0_ISR(void) interrupt 1
  33          {
  34   1          TH0 = (unsigned char)(half_period >> 8);
  35   1          TL0 = (unsigned char)half_period;
  36   1          BEEP = !BEEP;
  37   1      }
  38          
  39          void Timer1_ISR(void) interrupt 3
  40          {
  41   1          TH1 = 0xFC;
  42   1          TL1 = 0x67;
  43   1          if (state == MUS_PLAY)
  44   1          {
  45   2              music_time_ms++;
  46   2              if (++clock_div >= 4)
  47   2              {
  48   3                  clock_div = 0;
  49   3                  music_clock_tick++;
  50   3              }
  51   2          }
  52   1          if (g_ui_ms != 0) g_ui_ms--;
  53   1      }
  54          
  55          static void Tone_On(unsigned char note)
C51 COMPILER V9.60.7.0   MUSIC                                                             09/30/2026 13:15:47 PAGE 2   

  56          {
  57   1          unsigned char saved_ea = EA;
  58   1      
  59   1          /* half_period is read by Timer 0.  Keep the 16-bit update and reload
  60   1           * atomic; otherwise a Timer 0 interrupt can observe one old and one new
  61   1           * byte and produce an invalid/repeating tone. */
  62   1          EA = 0;
  63   1          if (note >= 37)
  64   1          {
  65   2              EA = saved_ea;
  66   2              return;
  67   2          }
  68   1          half_period = TONE[note];
  69   1          TH0 = (unsigned char)(half_period >> 8);
  70   1          TL0 = (unsigned char)half_period;
  71   1          if (!display_muted) TR0 = 1;
  72   1          EA = saved_ea;
  73   1      }
  74          
  75          static void Tone_Off(void)
  76          {
  77   1          unsigned char saved_ea = EA;
  78   1      
  79   1          EA = 0;
  80   1          TR0  = 0;
  81   1          BEEP = 0;
  82   1          EA = saved_ea;
  83   1      }
  84          
  85          static void Start_Event_At(unsigned int start_ms)
  86          {
  87   1          unsigned char note;
  88   1          unsigned char units;
  89   1          unsigned int  ms;
  90   1      
  91   1          /* Every caller checks the terminator first, but keep this guard here as
  92   1           * well so a damaged index can only stop the song instead of indexing
  93   1           * outside the code table and jumping to a random result page. */
  94   1          if (song == 0 || idx >= 65534U || song[idx] == N_END)
  95   1          {
  96   2              state = MUS_STOP;
  97   2              gap_ms = 0;
  98   2              Tone_Off();
  99   2              return;
 100   2          }
 101   1      
 102   1          note  = song[idx];
 103   1          units = song[idx + 1];
 104   1          idx += 2;
 105   1          ms = (unsigned int)units * unit_ms;
 106   1      
 107   1          if (note == N_REST)
 108   1          {
 109   2              Tone_Off();
 110   2              phase    = 1;
 111   2              gap_ms   = ms;
 112   2              music_deadline_ms = (unsigned int)(start_ms + ms);
 113   2              return;
 114   2          }
 115   1      
 116   1          if (note >= 37)
 117   1          {
C51 COMPILER V9.60.7.0   MUSIC                                                             09/30/2026 13:15:47 PAGE 3   

 118   2              state = MUS_STOP;
 119   2              gap_ms = 0;
 120   2              Tone_Off();
 121   2              return;
 122   2          }
 123   1      
 124   1          /* Keep a visible, quiet bus window after every note.  The minimum is
 125   1           * deliberately a little longer than the fast LCD frame transaction. */
 126   1          gap_ms = ms >> 4;
 127   1          if (gap_ms < 8) gap_ms = 8;
 128   1          if (gap_ms > (ms >> 1)) gap_ms = ms >> 1;
 129   1      
 130   1          Tone_On(note);
 131   1          phase    = 0;
 132   1          music_deadline_ms = (unsigned int)(start_ms + ms - gap_ms);
 133   1      }

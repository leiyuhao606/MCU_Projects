 135          void Music_Init(void)
 136          {
 137   1          TMOD = 0x11;
 138   1      
 139   1          TR0  = 0;
 140   1          BEEP = 0;
 141   1      
 142   1          TH1  = 0xFC;
 143   1          TL1  = 0x67;
 144   1          TR1  = 1;
 145   1      
 146   1          music_time_ms  = 0;
 147   1          music_deadline_ms = 0;
 148   1          g_ui_ms        = 0;
 149   1          music_clock_tick = 0;
 150   1          clock_div = 0;
 151   1          display_muted   = 0;
 152   1          half_period    = TONE[24];
 153   1      
 154   1          ET0 = 1;
 155   1          ET1 = 1;
 156   1          /* Finish loading the first table before either timer can observe the
 157   1           * partially initialized song state. */
 158   1          EA  = 0;
 159   1          Music_Load(0);
 160   1          EA  = 1;
 161   1      }

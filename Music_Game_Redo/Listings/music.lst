 296          void Music_Run(void)
 297          {
 298   1          unsigned int now;
 299   1          unsigned char steps;
 300   1      
 301   1          if (state != MUS_PLAY) return;
 302   1      
 303   1          now = Music_TimeMs();
C51 COMPILER V9.60.7.0   MUSIC                                                             09/30/2026 13:15:47 PAGE 6   

 304   1      
 305   1          /* The loop normally executes once.  A bounded catch-up handles a
 306   1           * foreground LCD transfer that crossed several short phases while still
 307   1           * guaranteeing that a malformed table cannot trap the main loop.  Each
 308   1           * new deadline is based on the previous deadline, preserving the original
 309   1           * song tempo instead of restarting the phase from a late foreground time. */
 310   1          for (steps = 0; steps < 8; steps++)
 311   1          {
 312   2              if (!Deadline_Reached(now, music_deadline_ms)) return;
 313   2      
 314   2              if (phase == 0)
 315   2              {
 316   3                  Tone_Off();
 317   3                  phase = 1;
 318   3                  music_deadline_ms = (unsigned int)(music_deadline_ms + gap_ms);
 319   3                  continue;
 320   3              }
 321   2      
 322   2              if (song == 0 || song[idx] == N_END)
 323   2              {
 324   3                  state = MUS_STOP;
 325   3                  Tone_Off();
 326   3                  return;
 327   3              }
 328   2              Start_Event_At(music_deadline_ms);
 329   2              if (state != MUS_PLAY) return;
 330   2          }
 331   1      }



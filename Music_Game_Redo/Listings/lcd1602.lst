   1          #include <REGX52.H>
   2          #include <intrins.h>
   3          #include "lcd1602.h"
   4          #include "delay.h"
   5          
   6          /* LCD1602 wiring on the PuZhong board:
   7           * RS -> P2.6, RW -> P2.5, E -> P2.7, D0..D7 -> P0.  P2.5 is also the
   8           * buzzer output.  The game mutes Timer 0 briefly while it transfers a frame. */
   9          sbit LCD1602_RS = P2^6;
  10          sbit LCD1602_RW = P2^5;
  11          sbit LCD1602_E  = P2^7;
  12          
  13          #define LCD1602_DATAPORT P0
  14          
  15          /* A normal HD44780 data/command write needs roughly 37 us.  The original
  16           * player used a millisecond delay for every byte, which makes a pixel frame
  17           * too slow; this calibrated short wait keeps the shared buzzer pin quiet for
  18           * only the actual LCD transaction.  Clear/home still receive a full delay. */
  19          static void LCD1602_ShortWait(void)
  20          {
  21   1          unsigned char i = 12;
  22   1      
  23   1          while (i--)
  24   1          {
  25   2              _nop_();
  26   2          }
  27   1      }
  28          
  29          void LCD1602_WriteCommand(unsigned char Command)
  30          {
  31   1          LCD1602_RS = 0;
  32   1          LCD1602_RW = 0;
  33   1          LCD1602_DATAPORT = Command;
  34   1          LCD1602_E = 1;
  35   1          LCD1602_ShortWait();
  36   1          LCD1602_E = 0;
  37   1          LCD1602_ShortWait();
  38   1      }
  39          
  40          void LCD1602_WriteData(unsigned char Data)
  41          {
  42   1          LCD1602_RS = 1;
  43   1          LCD1602_RW = 0;
  44   1          LCD1602_DATAPORT = Data;
  45   1          LCD1602_E = 1;
  46   1          LCD1602_ShortWait();
  47   1          LCD1602_E = 0;
  48   1          LCD1602_ShortWait();
  49   1      }
  50          
  51          void LCD1602_Init(void)
  52          {
  53   1          LCD1602_WriteCommand(0x38);     /* 8-bit bus, 2 lines, 5x7 dots */
  54   1          Delay_ms(1);
  55   1          LCD1602_WriteCommand(0x0C);     /* display on, cursor off       */
C51 COMPILER V9.60.7.0   LCD1602                                                           09/30/2026 13:15:47 PAGE 2   

  56   1          Delay_ms(1);
  57   1          LCD1602_WriteCommand(0x06);     /* auto increment, no shift     */
  58   1          Delay_ms(1);
  59   1          LCD1602_WriteCommand(0x01);     /* clear                        */
  60   1          Delay_ms(2);
  61   1      }
  62          
  63          void LCD1602_SetCursor(unsigned char Line, unsigned char Column)
  64          {
  65   1          if (Line == 1)
  66   1          {
  67   2              LCD1602_WriteCommand(0x80 | (Column - 1));
  68   2          }
  69   1          else
  70   1          {
  71   2              LCD1602_WriteCommand(0x80 | (Column - 1) + 0x40);
  72   2          }
  73   1      }
  74          
  75          void LCD1602_ShowChar(unsigned char Line, unsigned char Column, unsigned char Char)
  76          {
  77   1          LCD1602_SetCursor(Line, Column);
  78   1          LCD1602_WriteData(Char);
  79   1      }
  80          
  81          void LCD1602_ShowString(unsigned char Line, unsigned char Column, unsigned char code *String)
  82          {
  83   1          unsigned char i;
  84   1      
  85   1          LCD1602_SetCursor(Line, Column);
  86   1          for (i = 0; String[i] != '\0'; i++)
  87   1          {
  88   2              LCD1602_WriteData(String[i]);
  89   2          }
  90   1      }
  91          
  92          /* Dynamic game frames are assembled in internal RAM.  Keil C51 keeps code
  93           * and data pointers distinct, so provide a RAM variant instead of casting a
  94           * pointer across memory spaces. */
  95          void LCD1602_LoadCharRam(unsigned char Location, unsigned char idata *Pattern)
  96          {
  97   1          unsigned char i;
  98   1      
  99   1          LCD1602_WriteCommand(0x40 | ((Location & 0x07) << 3));
 100   1          for (i = 0; i < 8; i++)
 101   1          {
 102   2              LCD1602_WriteData(Pattern[i]);
 103   2          }
 104   1      }



 413          
 414          static void Try_Hit(unsigned char row, unsigned int now)
 415          {
 416   1          unsigned int i;
 417   1          unsigned int best = CHART_MAX_COUNT;
 418   1          unsigned int best_diff = 0xFFFF;
 419   1          unsigned int x;
 420   1          unsigned int diff;
 421   1          unsigned char kind = 0;
 422   1          unsigned char best_kind = 0;
 423   1          unsigned int target;
 424   1      
 425   1          for (i = 0; i < chart_count; i++)
 426   1          {
 427   2              if (Note_Is_Done(i) || game_chart[i].row != row) continue;
C51 COMPILER V9.60.7.0   MAIN                                                              09/30/2026 13:15:47 PAGE 8   

 428   2      
 429   2              target = Note_TargetTick(i);
 430   2              if (now + TRAVEL_TICKS < target) continue;
 431   2              if (now > target + MISS_AFTER_TICKS)
 432   2              {
 433   3                  Note_Mark_Done(i);
 434   3                  continue;
 435   3              }
 436   2      
 437   2              x = Note_X(now, target);
 438   2              if (x >= 55 && x <= 57)
 439   2              {
 440   3                  diff = (unsigned int)(x > 56 ? x - 56 : 56 - x);
 441   3                  kind = 2;                    /* Perfect */
 442   3              }
 443   2              else if (x == 54 || x == 58)
 444   2              {
 445   3                  diff = 2;
 446   3                  kind = 1;                    /* Great */
 447   3              }
 448   2              else
 449   2              {
 450   3                  continue;
 451   3              }
 452   2      
 453   2              if (diff < best_diff)
 454   2              {
 455   3                  best_diff = diff;
 456   3                  best = i;
 457   3                  best_kind = kind;
 458   3              }
 459   2          }
 460   1      
 461   1          if (best >= chart_count) return;
 462   1      
 463   1          Note_Mark_Done(best);
 464   1          if (best_kind == 2) perfect_hits++;
 465   1          else           great_hits++;
 466   1          hit_flash[row] = HIT_FLASH_TICKS;
 467   1          hit_quality[row] = best_kind;
 468   1          feedback_timer = HIT_FLASH_TICKS;
 469   1          feedback_char = (unsigned char)((best_kind == 2) ? 'P' : 'G');
 470   1          last_frame_tick = (unsigned int)(now - FRAME_TICKS);
 471   1      }
 472          
 473          static void Handle_Pressed(unsigned char pressed, unsigned int now)
 474          {
 475   1          /* Top-to-bottom lanes are K4, K3, K2, K1, i.e. right-to-left physically. */
 476   1          if (pressed & KEY_MASK_STOP) Try_Hit(0, now);
 477   1          if (pressed & KEY_MASK_NEXT) Try_Hit(1, now);
 478   1          if (pressed & KEY_MASK_MODE) Try_Hit(2, now);
 479   1          if (pressed & KEY_MASK_PREV) Try_Hit(3, now);
 480   1      }

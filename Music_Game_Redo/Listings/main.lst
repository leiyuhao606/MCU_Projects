   1          /*
   2           * Music Game Redo - STC89C52RC + LCD1602
   3           *
   4           * The LCD1602 gives us four 4-pixel lanes: the upper and lower half of each
   5           * character row.  Notes are 3 pixels wide by 4 pixels high and travel from
   6           * the left edge to the centre pixel of character column 12 (x = 57).  The
   7           * travel time is deliberately close to two seconds so a frame never skips a
   8           * visible pixel.  A note
   9           * is Perfect when its three columns include x = 57; it is Great only when a
  10           * note column is immediately beside that line (x = 54 or x = 58).
  11           *
  12           * Lane/key wiring follows the board schematic's physical right-to-left
  13           * requirement:
  14           *   LCD top       -> K4 / P3.3
  15           *   LCD upper     -> K3 / P3.2
  16           *   LCD lower     -> K2 / P3.0
  17           *   LCD bottom    -> K1 / P3.1
  18           *
  19           * Music and the two song tables are carried over from the standalone player;
  20           * charts.h selects real non-rest note starts from those same tables so their
  21           * Perfect moments stay aligned with audible notes.
  22           */
  23          
  24          #include <REGX52.H>
  25          #include "lcd1602.h"
  26          #include "keypad.h"
  27          #include "delay.h"
  28          #include "music.h"
  29          #include "charts.h"
  30          
  31          #define UI_SELECT       0
  32          #define UI_GAME         1
  33          #define UI_RESULT       2
  34          
  35          #define LCD_CELLS       16
  36          #define LCD_PIXEL_W     80
  37          #define JUDGE_X         57
  38          #define NOTE_WIDTH      3
  39          #define TRAVEL_TICKS       480U   /* 480 * 4 ms = 1.92 s */
  40          #define MISS_AFTER_TICKS    90U   /* 360 ms */
  41          #define FRAME_TICKS           4U  /* 16 ms */
  42          #define INPUT_STABLE_TICKS    4U  /* 16 ms; also rejects most IR bursts */
  43          #define HIT_FLASH_TICKS      24U  /* 96 ms; six visible 16-ms frames */
  44          
  45          /* CGRAM slot 1 and 2 are the two independent judgement-line cells.  Slots
  46           * 0 and 3..7 are allocated to cells containing moving note pixels for this
  47           * frame.  0xFF in cell_code means that a cell has not been allocated yet. */
  48          #define LINE_SLOT_TOP   1
  49          #define LINE_SLOT_BOTTOM 2
  50          #define NOTE_SLOT_FIRST 3
  51          #define NOTE_SLOT_LAST  7
  52          
  53          static unsigned char ui;
  54          static unsigned char sel;
  55          

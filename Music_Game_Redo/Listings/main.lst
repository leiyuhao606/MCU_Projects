 234          static void Graphics_Reset(void)
 235          {
 236   1          unsigned char slot;
 237   1          unsigned char row;
 238   1          unsigned char cell;
 239   1          unsigned char i;
 240   1      
 241   1          for (slot = 0; slot < 8; slot++)
C51 COMPILER V9.60.7.0   MAIN                                                              09/30/2026 13:15:47 PAGE 5   

 242   1          {
 243   2              for (row = 0; row < 8; row++) glyph[slot][row] = 0;
 244   2          }
 245   1          for (cell = 0; cell < 32; cell++) cell_code[cell] = 0xFF;
 246   1      
 247   1          /* One-pixel judgement line at the centre of column 12 on both LCD rows. */
 248   1          cell_code[11] = LINE_SLOT_TOP;
 249   1          cell_code[27] = LINE_SLOT_BOTTOM;
 250   1          for (row = 0; row < 8; row++)
 251   1          {
 252   2              glyph[LINE_SLOT_TOP][row] = 0x10;
 253   2              glyph[LINE_SLOT_BOTTOM][row] = 0x10;
 254   2          }
 255   1      
 256   1          /* A hit flashes the complete 5x4 area at the judgement line.  Perfect is
 257   1           * a solid bar; Great is a broken bar so the two results are distinguishable
 258   1           * even without adding text to the four-lane playfield. */
 259   1          for (row = 0; row < 4; row++)
 260   1          {
 261   2              if (hit_flash[row] != 0)
 262   2              {
 263   3                  slot = (unsigned char)((row < 2) ? LINE_SLOT_TOP : LINE_SLOT_BOTTOM);
 264   3                  cell = (unsigned char)(((row == 0) || (row == 2)) ? 0 : 4);
 265   3                  for (i = 0; i < 4; i++)
 266   3                  {
 267   4                      glyph[slot][cell + i] =
 268   4                          (unsigned char)((hit_quality[row] == 2) ? 0x1F : 0x15);
 269   4                  }
 270   3              }
 271   2          }
 272   1          /* Columns 1..14 are reserved for the playfield.  The rightmost cell of
 273   1           * the lower LCD row is therefore a stable, readable hit indicator. */
 274   1          if (feedback_timer != 0) cell_code[31] = feedback_char;
 275   1          next_glyph = NOTE_SLOT_FIRST;
 276   1      }

 108   1          unsigned char count = 0;
 109   1      
 110   1          do
 111   1          {
 112   2              digits[count++] = (unsigned char)('0' + (value % 10UL));
 113   2              value /= 10UL;
 114   2          } while (value != 0 && count < 10);
 115   1      
 116   1          while (count != 0)
 117   1          {
C51 COMPILER V9.60.7.0   MAIN                                                              09/30/2026 13:15:47 PAGE 3   

 118   2              LCD1602_ShowChar(line, column++, digits[--count]);
 119   2          }
 120   1      }

 122          static unsigned char code *Rating_Name(unsigned long score)
 123          {
 124   1          if (score >= 1000000UL) return RATING_PHI;
 125   1          if (score >= 920000UL)  return RATING_V;
 126   1          if (score >= 880000UL)  return RATING_S;
 127   1          if (score >= 800000UL)  return RATING_A;
 128   1          if (score >= 700000UL)  return RATING_B;
 129   1          if (score >= 600000UL)  return RATING_C;
 130   1          return RATING_D;
 131   1      }

  59          static unsigned int perfect_hits;
  60          static unsigned int great_hits;
  61          static unsigned long final_score;
  62          
  63          /* Pixel renderer buffers.  8 * 8 bytes are the seven dynamic CGRAM glyphs
  64           * plus an unused slot zero; cell_code stores a CGRAM code or zero for blank. */
  65          /* The STC89C52RC has 256 bytes of indirect internal RAM.  Keep the dynamic
  66           * 64-byte glyph table there so the ordinary DATA area still leaves room for
  67           * the call stack and C51's temporary values. */
  68          static unsigned char idata glyph[8][8];
  69          static unsigned char idata cell_code[32];
  70          static unsigned int idata lcd_glyph_hash[8];
  71          /* Two 4-bit screen tags per byte: 0=space, 1..8=CGRAM 0..7,
  72           * 9='P', 10='G'.  The LCD shadow therefore costs 16 bytes instead of 32. */
  73          static unsigned char idata lcd_cell[16];
  74          static unsigned char next_glyph;
  75          

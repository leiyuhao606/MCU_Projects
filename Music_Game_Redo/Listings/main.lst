 329          static void Game_Render(unsigned int now)
 330          {
 331   1          unsigned int i;
 332   1          unsigned int target;
 333   1          unsigned int x;
 334   1          unsigned char slot;
 335   1          unsigned char row;
 336   1          unsigned int hash;
 337   1          unsigned char value;
 338   1          unsigned char tag;
 339   1          unsigned char old_tag;
 340   1          unsigned char packed;
 341   1          unsigned char need_display;
 342   1      
 343   1          Graphics_Reset();

 204          /* ---- pixel renderer ----------------------------------------------------- */
 205          
 206          static unsigned char Dot_Mask(unsigned int x)
 207          {
 208   1          /* CGRAM bit 4 is the leftmost dot of the 5-dot character cell. */
 209   1          return (unsigned char)(0x10 >> (x % 5));
 210   1      }
 211          
 212          static unsigned char Graphics_Slot(unsigned char cell)
 213          {
 214   1          if (cell == 11) return LINE_SLOT_TOP;
 215   1          if (cell == 27) return LINE_SLOT_BOTTOM;
 216   1      
 217   1          if (cell_code[cell] != 0xFF) return cell_code[cell];
 218   1      
 219   1          if (next_glyph <= NOTE_SLOT_LAST)
 220   1          {
 221   2              cell_code[cell] = next_glyph;
 222   2              return next_glyph++;
 223   2          }
 224   1          if (next_glyph == (unsigned char)(NOTE_SLOT_LAST + 1))
 225   1          {
 226   2              next_glyph = (unsigned char)(NOTE_SLOT_LAST + 2);
 227   2              cell_code[cell] = 0;          /* CGRAM slot zero */
 228   2              return 0;
 229   2          }
 230   1      
 231   1          return 0xFF;                       /* chart spacing should avoid this */
 232   1      }

 302          static void Graphics_Add_Note(unsigned char row, unsigned int x)
 303          {
C51 COMPILER V9.60.7.0   MAIN                                                              09/30/2026 13:15:47 PAGE 6   

 304   1          unsigned char lane_y;
 305   1          unsigned char line;
 306   1          unsigned char cell;
 307   1          unsigned char slot;
 308   1          unsigned char pixel;
 309   1          unsigned char i;
 310   1      
 311   1          line = (unsigned char)((row < 2) ? 0 : 1);
 312   1          lane_y = (unsigned char)(((row == 0) || (row == 2)) ? 0 : 4);
 313   1      
 314   1          for (i = 0; i < NOTE_WIDTH; i++)
 315   1          {
 316   2              pixel = (unsigned char)(x + i);
 317   2              if (pixel >= LCD_PIXEL_W) continue;
 318   2      
 319   2              cell = (unsigned char)(line * LCD_CELLS + pixel / 5);
 320   2              slot = Graphics_Slot(cell);
 321   2              if (slot == 0xFF) continue;    /* chart spacing keeps this rare */
 322   2              glyph[slot][lane_y + 0] |= Dot_Mask(pixel);
 323   2              glyph[slot][lane_y + 1] |= Dot_Mask(pixel);
 324   2              glyph[slot][lane_y + 2] |= Dot_Mask(pixel);
 325   2              glyph[slot][lane_y + 3] |= Dot_Mask(pixel);
 326   2          }
 327   1      }

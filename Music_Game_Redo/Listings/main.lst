 394   1      
 395   1          for (i = 0; i < 32; i++)
 396   1          {
 397   2              value = (cell_code[i] != 0xFF) ? cell_code[i] : ' ';
 398   2              tag = Cell_Tag(value);
 399   2              packed = lcd_cell[i >> 1];
 400   2              old_tag = (unsigned char)((i & 1) ? (packed >> 4) : (packed & 0x0F));
 401   2              if (old_tag == tag) continue;
 402   2              LCD1602_SetCursor((unsigned char)((i < 16) ? 1 : 2),

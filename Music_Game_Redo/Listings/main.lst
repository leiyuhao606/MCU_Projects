 379   1      
 380   1          Music_DisplayBegin();
 381   1          for (slot = 0; slot < next_glyph; slot++)
 382   1          {
 383   2              hash = 0;
 384   2              for (row = 0; row < 8; row++)
 385   2              {
 386   3                  hash = (unsigned int)((hash << 1) ^ glyph[slot][row] ^ 0x009D);
 387   3              }
 388   2              if (hash != lcd_glyph_hash[slot])
 389   2              {
 390   3                  LCD1602_LoadCharRam(slot, glyph[slot]);

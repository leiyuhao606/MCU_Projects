 369   2          }
 370   1          for (i = 0; i < 32; i++)
 371   1          {
 372   2              value = (cell_code[i] != 0xFF) ? cell_code[i] : ' ';
 373   2              tag = Cell_Tag(value);
 374   2              packed = lcd_cell[i >> 1];
 375   2              old_tag = (unsigned char)((i & 1) ? (packed >> 4) : (packed & 0x0F));

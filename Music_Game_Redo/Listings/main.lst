 160          /* ---- chart status and score -------------------------------------------- */
 161          
 162          static unsigned char Note_Is_Done(unsigned int index)
 163          {
 164   1          return (unsigned char)((note_done[index >> 3] >> (index & 7)) & 0x01);
 165   1      }
 166          
 167          static void Note_Mark_Done(unsigned int index)
 168          {
 169   1          note_done[index >> 3] |= (unsigned char)(1 << (index & 7));
 170   1      }
 171          
 172          static unsigned int Note_TargetTick(unsigned int index)
 173          {
 174   1          unsigned int units = game_chart[index].at;
 175   1          unsigned char unit = Music_UnitMs();
 176   1      
 177   1          /* Divide the unit duration before multiplying.  This keeps the complete
 178   1           * song clock inside 16 bits while retaining a 4 ms timing resolution. */
 179   1          return (unsigned int)(units * (unsigned int)(unit / 4)
C51 COMPILER V9.60.7.0   MAIN                                                              09/30/2026 13:15:47 PAGE 4   

 180   1                 + (units * (unsigned int)(unit % 4)) / 4);
 181   1      }
 182          
 183          /* The denominator stays below 100 * 109, so splitting 1,000,000 into a
 184           * quotient and remainder avoids a 32-bit overflow while preserving exact
 185           * AllPerfect = 1,000,000 and ordinary integer rounding for every other run. */
 186          static unsigned long Calculate_Score(void)
 187          {
 188   1          unsigned long weighted;
 189   1          unsigned long denominator;
 190   1          unsigned long whole;
 191   1          unsigned long remainder;
 192   1      
 193   1          weighted = (unsigned long)perfect_hits * 100UL;
 194   1          weighted += (unsigned long)great_hits * 60UL;
 195   1          denominator = (unsigned long)chart_count * 100UL;
 196   1      
 197   1          whole = 1000000UL / denominator;
 198   1          remainder = 1000000UL % denominator;
 199   1          return weighted * whole
 200   1               + (weighted * remainder + denominator / 2UL) / denominator;
 201   1      }

 278          static void Graphics_Invalidate(void)
 279          {
 280   1          unsigned char slot;
 281   1          unsigned char cell;
 282   1      
 283   1          for (slot = 0; slot < 8; slot++) lcd_glyph_hash[slot] = 0xFFFF;
 284   1          for (cell = 0; cell < 16; cell++) lcd_cell[cell] = 0xFF;
 285   1      }
 286          
 287          static unsigned char Cell_Tag(unsigned char value)
 288          {
 289   1          if (value == ' ') return 0;
 290   1          if (value == 'P') return 9;
 291   1          if (value == 'G') return 10;
 292   1          return (unsigned char)(value + 1);
 293   1      }
 294          
 295          static unsigned int Note_X(unsigned int now, unsigned int target)
 296          {
 297   1          unsigned int elapsed = (unsigned int)(now + TRAVEL_TICKS - target);
 298   1      
 299   1          return (unsigned int)((elapsed * JUDGE_X) / TRAVEL_TICKS);
 300   1      }
